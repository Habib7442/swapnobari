# Copy to .env.local and fill in. Never commit .env.local.

# Swapnobari's WhatsApp number: 10-digit Indian mobile, no +91 (it is added automatically).
# Server-only: read in lib/env.ts and passed to components as a prop.
WHATSAPP_NUMBER=

# Canonical site URL (no trailing slash). Defaults to https://swapnobari.in.
NEXT_PUBLIC_SITE_URL=https://swapnobari.in

# Optional: Google Search Console HTML-tag verification code (only the content="..." value).
# Not needed if you verify with the DNS TXT record in Cloudflare (recommended).
GOOGLE_SITE_VERIFICATION=
