# Copy to .env.local and fill in. Never commit .env.local.

# --- Site -------------------------------------------------------------------
# Canonical site URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://swapnobari.in
# Swapnobari's WhatsApp number: 10-digit Indian mobile, no +91 (added automatically). Server-only.
WHATSAPP_NUMBER=
# Optional: Google Search Console HTML-tag code. Not needed with DNS TXT verification.
GOOGLE_SITE_VERIFICATION=

# --- Supabase (Project Settings -> API Keys) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...): safe for the browser, limited by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): full access, bypasses RLS. Server only. Never share.
SUPABASE_SECRET_KEY=

# --- Spam protection (Cloudflare -> Turnstile) -----------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Random string used to hash visitor IPs for rate limiting. Generate once, keep secret.
IP_HASH_SALT=

# --- Lead email alerts (Resend) --------------------------------------------
RESEND_API_KEY=
# Comma-separated list of inboxes that receive new-lead alerts.
LEAD_ALERT_EMAIL=
# Must use a domain verified in Resend.
LEAD_ALERT_FROM=Swapnobari Leads <leads@swapnobari.in>
